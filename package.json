{
  "name": "tilerise",
  "version": "0.1.2",
  "description": "Solid Canvas 2.5D buildings for OpenLayers",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.build.json",
    "build:demo": "vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "prepack": "npm run build",
    "format": "prettier --write src demo tests *.ts *.json index.html"
  },
  "peerDependencies": {
    "ol": "^10.6.0"
  },
  "dependencies": {
    "osmtogeojson": "^3.0.0-beta.5",
    "polygon-clipping": "^0.15.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/geojson": "^7946.0.16",
    "@types/osmtogeojson": "^2.2.34",
    "@types/vt-pbf": "^3.1.1",
    "ol": "^10.11.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vitest": "^5.0.5",
    "vt-pbf": "^3.1.3"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.15"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
